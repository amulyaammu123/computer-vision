import cv2

cap = cv2.VideoCapture("video.mp4")

while cap.isOpened():
    ret, frame = cap.read()

    if not ret:
        break

    cv2.imshow("Normal Speed", frame)
    cv2.waitKey(30)

    cv2.imshow("Slow Motion", frame)
    cv2.waitKey(100)

    cv2.imshow("Fast Motion", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
